# ─────────────────────────────────────────────
# The Viva Verse — Backend Environment Template
# ─────────────────────────────────────────────
# Copy this file to `.env` and fill in your values.
# NEVER commit the actual `.env` file to GitHub.

# CORS — Comma-separated list of allowed frontend origins
# Default for local dev: http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Backend server host and port (used when running with uvicorn directly)
HOST=0.0.0.0
PORT=8000

# Gemini API Key — used for embeddings (gemini-embedding-001) and question generation
# Get a free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Notification Services
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
