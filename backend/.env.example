# ─────────────────────────────────────────────
# The Viva Verse — Backend Environment Template
# ─────────────────────────────────────────────
# Copy this file to `.env` and fill in your values.
# NEVER commit the actual `.env` file to GitHub.

# CORS — Comma-separated list of allowed frontend origins
# Default for local dev: http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Backend server host and port (used when running with uvicorn directly)
HOST=0.0.0.0
PORT=8000

# SBERT model name — change if you want a different Sentence-Transformers model
SBERT_MODEL=all-MiniLM-L6-v2
